# ================================================================
# CONFIGURAÇÃO - SINCRONIZAÇÃO GEOTAB → SUPABASE
# Copie este arquivo para .env e preencha seus valores
# ================================================================

# ======== SUPABASE (Você já deve ter estas) ========
SUPABASE_URL=https://sua-url-aqui.supabase.co
SUPABASE_ANON_KEY=eyJh_sua_chave_aqui
SUPABASE_SERVICE_ROLE_KEY=eyJh_sua_chave_service_role_aqui

# ======== BANCO MYGEOTAB ADAPTER (Local) ========
# Host do servidor PostgreSQL onde está o MyGeotab Adapter
GEOTAB_DB_HOST=localhost
GEOTAB_DB_PORT=5432
GEOTAB_DB_NAME=mygeotab_adapter
GEOTAB_DB_USER=postgres
GEOTAB_DB_PASSWORD=sua_senha_postgres

# ======== PIPELINE ========
CSV_FOLDER=./input
LOG_FOLDER=./logs

# ================================================================
# INSTRUÇÕES:
# 1. Abra seu arquivo .env existente
# 2. Adicione as linhas acima com seus valores reais
# 3. Salve o arquivo
# ================================================================
